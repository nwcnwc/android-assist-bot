<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/ink"
            android:textSize="32sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autoLink="web"
            android:lineSpacingExtra="3dp"
            android:text="@string/setup_steps"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/checklist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/last_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            style="@style/Label"
            android:text="@string/webhook_label" />

        <TextView
            style="@style/Helper"
            android:text="@string/webhook_help" />

        <EditText
            android:id="@+id/webhook"
            style="@style/Field"
            android:hint="@string/webhook_hint"
            android:inputType="textUri"
            android:singleLine="true" />

        <TextView
            style="@style/Label"
            android:text="@string/auth_label" />

        <TextView
            style="@style/Helper"
            android:text="@string/auth_help" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/auth"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:hint="@string/auth_hint"
                android:inputType="textPassword"
                android:singleLine="true" />

            <Button
                android:id="@+id/auth_toggle"
                style="@style/QuietButton"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:minWidth="72dp"
                android:text="@string/show" />
        </LinearLayout>

        <Switch
            android:id="@+id/include_screenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:checked="true"
            android:minHeight="48dp"
            android:showText="false"
            android:text="@string/include_screenshot_label"
            android:textOff=""
            android:textOn=""
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            style="@style/Helper"
            android:text="@string/privacy_note" />

        <Button
            android:id="@+id/save"
            style="@style/AccentButton"
            android:text="@string/save" />

        <Button
            android:id="@+id/assistant_button"
            style="@style/AccentButton"
            android:text="@string/assistant_set" />

        <Button
            android:id="@+id/test"
            style="@style/QuietButton"
            android:text="@string/test" />

        <Button
            android:id="@+id/mic_button"
            style="@style/QuietButton"
            android:text="@string/mic_allow" />

        <Button
            android:id="@+id/note_button"
            style="@style/QuietButton"
            android:text="@string/notes_allow" />

        <TextView
            style="@style/Label"
            android:text="@string/how_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/how_body"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/advanced_toggle"
            style="@style/QuietButton"
            android:text="@string/advanced" />

        <LinearLayout
            android:id="@+id/advanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/setup_link_help"
                android:textColor="@color/faint"
                android:textSize="13sp" />

            <TextView
                style="@style/Label"
                android:text="@string/log_label" />

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
